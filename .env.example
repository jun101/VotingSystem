# Copy to .env (make setup does it) and fill in. Never commit .env.
# A secret has no value here: make setup generates every missing one and never
# replaces a value that is already set.

# --- Stack -------------------------------------------------------------------------
# Port of http://localhost:<HTTP_PORT>, the only address of the application.
HTTP_PORT=8080
# Mailpit's web page (emails caught in development), on this computer only.
MAILPIT_PORT=8025
# Owner of the files the containers write in the source folders (set by make setup).
HOST_UID=
HOST_GID=

# --- Application -------------------------------------------------------------------
APP_NAME="New Voting System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_LEVEL=debug
MAIL_FROM_ADDRESS=no-reply@localhost

# --- Secrets (generated) -----------------------------------------------------------
# Framework key: sessions, encrypted columns. base64 of 32 random bytes.
APP_KEY=
# 64 hex characters (32 bytes). Encrypts the vote audit records (SPEC FR-SEC-08).
# Generate with: openssl rand -hex 32
VOTE_AUDIT_KEY=
# 64 hex characters. Keys the hash of the access codes (SPEC NFR-SEC-02).
# Generate with: openssl rand -hex 32
CREDENTIAL_HASH_KEY=

# --- Database and Redis (passwords generated) --------------------------------------
DB_DATABASE=votesystem
# Used by the container's first start only; nothing in the application uses root.
DB_ROOT_PASSWORD=
# Account `app`: reads and writes data (api, queue, scheduler).
DB_PASSWORD=
# Account `migrator`: changes the schema (migrations only).
DB_MIGRATOR_PASSWORD=
REDIS_PASSWORD=
