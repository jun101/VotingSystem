# Copy to .env and fill in. Never commit .env.

# 64 hex characters (32 bytes). Encrypts the vote audit records (SPEC FR-SEC-08).
# Generate with: openssl rand -hex 32
VOTE_AUDIT_KEY=

# 64 hex characters. Keys the hash of the access codes (SPEC NFR-SEC-02).
# Generate with: openssl rand -hex 32
CREDENTIAL_HASH_KEY=
