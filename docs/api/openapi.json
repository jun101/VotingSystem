{
    "openapi": "3.1.0",
    "info": {
        "title": "New Voting System",
        "version": "1.0.0",
        "description": "API of the New Voting System. Conventions: docs/api/README.md."
    },
    "servers": [
        {
            "url": "http://localhost:8080/api",
            "description": "Same origin"
        }
    ],
    "paths": {
        "/v1/auth/csrf": {
            "get": {
                "operationId": "auth.csrf",
                "description": "Starts the browser's session if it has none and sets the `XSRF-TOKEN` cookie. The web\napplication calls it once before its first state-changing request, then copies the\ncookie's value into the `X-XSRF-TOKEN` header of every request that changes something.\nPublic. Limited to 60 requests per minute per IP address.",
                "summary": "Start the session and set the CSRF cookie",
                "tags": [
                    "Csrf"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/v1/auth/forgot-password": {
            "post": {
                "operationId": "auth.forgotPassword",
                "description": "Sends a reset link to the address, if it belongs to an account. The answer is the same\neither way, so the endpoint does not tell whether an account exists. Public. Limited\nto 5 requests per hour per IP address, and 3 per hour per email address.",
                "summary": "Ask for a password reset link",
                "tags": [
                    "ForgotPassword"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ForgotPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/health": {
            "get": {
                "operationId": "health",
                "description": "Says whether the database and Redis answer, and returns the database server's clock.\nPublic. Limited to 60 requests per minute per IP address.",
                "summary": "State of the API and of the services it depends on",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "const": "ok"
                                                },
                                                "checks": {
                                                    "type": "object",
                                                    "properties": {
                                                        "database": {
                                                            "type": "string",
                                                            "const": "ok"
                                                        },
                                                        "redis": {
                                                            "type": "string",
                                                            "const": "ok"
                                                        }
                                                    },
                                                    "required": [
                                                        "database",
                                                        "redis"
                                                    ]
                                                },
                                                "time": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "status",
                                                "checks",
                                                "time"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/auth/login": {
            "post": {
                "operationId": "auth.login",
                "description": "Signs a user in with email and password. The session id is regenerated. A platform\nadmin signs in here too. Public. Limited to 10 requests per minute per IP address, and\n5 failed attempts per minute for one email address from one IP address.",
                "summary": "Sign in",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "owner",
                                                        "manager",
                                                        "platform_admin"
                                                    ]
                                                },
                                                "email_verified": {
                                                    "type": "boolean"
                                                },
                                                "language": {
                                                    "type": "string",
                                                    "enum": [
                                                        "fr",
                                                        "en"
                                                    ]
                                                },
                                                "institution": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ],
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "school",
                                                                "university",
                                                                "association",
                                                                "other"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "id",
                                                        "name",
                                                        "type"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email",
                                                "role",
                                                "email_verified",
                                                "language",
                                                "institution"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "description": "Ends the session: it is destroyed in Redis and the CSRF token regenerated, so the old\nsession cookie opens nothing. Signed-in user.",
                "summary": "Sign out",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/me": {
            "get": {
                "operationId": "auth.me",
                "description": "The user and their institution (`null` for a platform admin). The web application reads\nit on every page of the admin area. A user whose institution was suspended since\nsign-in is refused, and the session is ended. Signed-in user.",
                "summary": "The signed-in user",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "owner",
                                                        "manager",
                                                        "platform_admin"
                                                    ]
                                                },
                                                "email_verified": {
                                                    "type": "boolean"
                                                },
                                                "language": {
                                                    "type": "string",
                                                    "enum": [
                                                        "fr",
                                                        "en"
                                                    ]
                                                },
                                                "institution": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ],
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "school",
                                                                "university",
                                                                "association",
                                                                "other"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "id",
                                                        "name",
                                                        "type"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email",
                                                "role",
                                                "email_verified",
                                                "language",
                                                "institution"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "patch": {
                "operationId": "me.update",
                "description": "In this slice, the language of the admin area (`fr` or `en`). It also becomes the language of\nthe emails sent to this user from then on. Only the signed-in user's own row changes; any\nother field of the body is ignored. Signed-in user.",
                "summary": "Change the signed-in user's settings",
                "tags": [
                    "Me"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateMeRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "owner",
                                                        "manager",
                                                        "platform_admin"
                                                    ]
                                                },
                                                "email_verified": {
                                                    "type": "boolean"
                                                },
                                                "language": {
                                                    "type": "string",
                                                    "enum": [
                                                        "fr",
                                                        "en"
                                                    ]
                                                },
                                                "institution": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ],
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "school",
                                                                "university",
                                                                "association",
                                                                "other"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "id",
                                                        "name",
                                                        "type"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email",
                                                "role",
                                                "email_verified",
                                                "language",
                                                "institution"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/register": {
            "post": {
                "operationId": "auth.register",
                "description": "Creates the institution and its first user, the owner, in one step, queues the\nverification email and signs the owner in. Public. Limited to 10 requests per hour\nper IP address.",
                "summary": "Register an institution and its owner",
                "tags": [
                    "Register"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "owner",
                                                        "manager",
                                                        "platform_admin"
                                                    ]
                                                },
                                                "email_verified": {
                                                    "type": "boolean"
                                                },
                                                "language": {
                                                    "type": "string",
                                                    "enum": [
                                                        "fr",
                                                        "en"
                                                    ]
                                                },
                                                "institution": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ],
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "school",
                                                                "university",
                                                                "association",
                                                                "other"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "id",
                                                        "name",
                                                        "type"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email",
                                                "role",
                                                "email_verified",
                                                "language",
                                                "institution"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/verify-email/resend": {
            "post": {
                "operationId": "auth.resendVerification",
                "description": "Sends a new verification email to the signed-in user; the previous link stops working.\nSigned-in user. Limited to 3 requests per minute per user.",
                "summary": "Send the verification email again",
                "tags": [
                    "ResendVerification"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/reset-password": {
            "post": {
                "operationId": "auth.resetPassword",
                "description": "Sets a new password with the token of the reset link. The user is not signed in, and\ntheir other sessions stop working. Public. Limited to 10 requests per hour per IP address.",
                "summary": "Set a new password",
                "tags": [
                    "ResetPassword"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResetPasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/v1/auth/verify-email": {
            "post": {
                "operationId": "auth.verifyEmail",
                "description": "Verifies the address with the token of the link sent by email. The person may open the\nlink in another browser than the one they registered with, so no session is needed and\nnobody is signed in by it. Public. Limited to 10 requests per minute per IP address.",
                "summary": "Verify an email address",
                "tags": [
                    "VerifyEmail"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/VerifyEmailRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "ForgotPasswordRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email"
                ],
                "title": "ForgotPasswordRequest"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 1024
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "institution_name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "minLength": 12,
                        "maxLength": 128
                    },
                    "language": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "fr",
                            "en",
                            null
                        ]
                    }
                },
                "required": [
                    "institution_name",
                    "name",
                    "email",
                    "password"
                ],
                "title": "RegisterRequest"
            },
            "ResetPasswordRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string",
                        "minLength": 12,
                        "maxLength": 128
                    }
                },
                "required": [
                    "token",
                    "password"
                ],
                "title": "ResetPasswordRequest"
            },
            "UpdateMeRequest": {
                "type": "object",
                "properties": {
                    "language": {
                        "type": "string",
                        "enum": [
                            "fr",
                            "en"
                        ]
                    }
                },
                "required": [
                    "language"
                ],
                "title": "UpdateMeRequest"
            },
            "UserResource": {
                "type": "array",
                "items": {},
                "title": "UserResource"
            },
            "VerifyEmailRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    }
                },
                "required": [
                    "token"
                ],
                "title": "VerifyEmailRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}