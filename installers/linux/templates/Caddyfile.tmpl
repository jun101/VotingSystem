# VoteSystem entry point (school edition, plain HTTP on the school's network). Written by the installer.
# The same routes and headers as docker/proxy/Caddyfile.
{
	admin off
	auto_https off
}

:{$WEB_PORT} {
	header {
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
		-Via
	}

	# The re-encoded pictures, read-only: only `*.webp` files that exist.
	handle /media/* {
		@found {
			path *.webp
			file {
				root /var/lib/votesystem
				try_files {path}
			}
		}
		handle @found {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				X-Content-Type-Options nosniff
				Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
			}
			root * /var/lib/votesystem
			file_server
		}
		handle {
			respond 404
		}
	}

	handle /api/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy 127.0.0.1:{$API_PORT}
	}

	handle {
		reverse_proxy 127.0.0.1:{$WEB_INTERNAL_PORT}
	}
}
