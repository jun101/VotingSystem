[Unit]
Description=VoteSystem database (MariaDB)
After=network.target

[Service]
Type=simple
User=votesystem
Group=votesystem
RuntimeDirectory=votesystem
RuntimeDirectoryPreserve=yes
ExecStart=@ROOT@/mariadb/bin/mariadbd --defaults-file=/etc/votesystem/mariadb.cnf
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
