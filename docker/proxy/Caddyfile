{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No page of the product is shown inside another site's frame (clickjacking).
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		# No header names the software or its version.
		-Server
		-X-Powered-By
		# The proxy adds `Via: 1.1 Caddy` to every answer.
		-Via
	}

	# The re-encoded pictures, read-only. The file name changes with every upload, so the
	# answer can be cached for good. No listing of the folder, no other type than the file's.
	handle /media/* {
		# The long cache is for files that exist; an answer "not found" is not kept.
		@exists file {
			root /srv
			try_files {path}
		}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		root * /srv
		file_server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
