{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No page of the product is shown inside another site's frame (clickjacking).
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		# No header names the software or its version.
		-Server
		-X-Powered-By
		# The proxy adds `Via: 1.1 Caddy` to every answer.
		-Via
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
