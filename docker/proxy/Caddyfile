{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		# Set only when the answer has none: the API sends its own, `no-referrer`.
		?Referrer-Policy strict-origin-when-cross-origin
		# No page of the product is shown inside another site's frame (clickjacking).
		X-Frame-Options DENY
		# Nothing of the product needs the camera, the microphone, the position or a payment.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# No header names the software or its version.
		-Server
		-X-Powered-By
		# The proxy adds `Via: 1.1 Caddy` to every answer.
		-Via
	}

	# The web application sends its own Content-Security-Policy (a nonce per request, web/src/proxy.ts) and
	# the API sends its own; the proxy adds none to them, so that a policy is never sent twice.

	# The re-encoded pictures, read-only: only `*.webp` files that exist. The file name changes
	# with every upload, so a file can be cached for good; every other answer (a missing file,
	# another type, a folder) is a plain 404 that is not kept. No listing of the folder.
	handle /media/* {
		@found {
			path *.webp
			file {
				root /srv
				try_files {path}
			}
		}
		handle @found {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				X-Content-Type-Options nosniff
				# A picture is shown as an image and runs nothing, even if opened by itself.
				Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
			}
			root * /srv
			file_server
		}
		handle {
			respond 404
		}
	}

	handle /api/* {
		# No body above the 5 MB picture limit and its multipart overhead reaches the API.
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
