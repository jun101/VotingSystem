# The production proxy (slice 19; slice 20 completes it: the Compose file, the certificate storage, logs).
# The development file is docker/proxy/Caddyfile (plain HTTP on :8080). Here Caddy gets and renews the
# certificate by itself for the host named in SITE_ADDRESS, so `auto_https` stays on.

{
	admin off
}

{$SITE_ADDRESS} {
	# The pictures under /media/ carry their own, stricter policy (see below).
	@notMedia not path /media/*

	header {
		# HTTPS only, for two years, subdomains included.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No page of the product is shown inside another site's frame (clickjacking).
		X-Frame-Options DENY
		# Nothing of the product needs the camera, the microphone, the position or a payment.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# No header names the software or its version.
		-Server
		-X-Powered-By
		-Via
	}

	header @notMedia Content-Security-Policy "frame-ancestors 'none'"

	handle /media/* {
		@found {
			path *.webp
			file {
				root /srv
				try_files {path}
			}
		}
		handle @found {
			header {
				Cache-Control "public, max-age=31536000, immutable"
				X-Content-Type-Options nosniff
				Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox"
			}
			root * /srv
			file_server
		}
		handle {
			respond 404
		}
	}

	handle /api/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
