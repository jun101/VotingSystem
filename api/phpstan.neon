includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
    ignoreErrors:
        -
            # Used by the models of slice 02 onward; tested in tests/Unit.
            identifier: trait.unused
            path: app/Models/Concerns/HasUuid.php
